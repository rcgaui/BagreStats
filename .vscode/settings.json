{
  // Usa o Python do ambiente virtual do projeto, nao o do sistema.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",

  // Liga o painel de testes do VS Code apontando para o pytest.
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests"],

  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true
  }
}
